{
  "name": "@artginzburg/next-ym",
  "version": "1.3.3",
  "description": "Yandex Metrica integration for Next.js v14",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "repository": "artginzburg/next-ym",
  "funding": "https://github.com/artginzburg/next-ym?sponsor=1",
  "author": {
    "name": "Vladislav Doronin",
    "email": "reapziq@gmail.com"
  },
  "contributors": [
    {
      "name": "Art Ginzburg",
      "email": "me+npm@ginzburg.art",
      "url": "https://ginzburg.art"
    }
  ],
  "license": "MIT",
  "keywords": [
    "next",
    "next.js",
    "yandex",
    "metrica",
    "metrika",
    "analytics"
  ],
  "scripts": {
    "build": "del-cli dist && tsc",
    "prepublishOnly": "pnpm build",
    "lint": "eslint src --fix --max-warnings 0",
    "lint:ts": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "format": "prettier --write --log-level silent .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@artginzburg/experimental": "^0.1.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/google.analytics": "^0.0.46",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.0.4",
    "prettier": "^3.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "next": ">=11.0.0",
    "react": ">=17.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
